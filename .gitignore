# Node dependencies
node_modules/

# Build output
/dist/
/dist-*/
/out-tsc/
/build/

# Angular cache and temporary files
/.angular
/.angular/cache

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Debug/temporary files
.sass-cache
.cache
/.tmp

# IDEs and editors
/.vscode/
/.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Coverage reports
/coverage/

# Environment files (often contain secrets) - keep example files in repo
/src/environments/*.ts
!src/environments/environment.example.ts
!src/environments/environment.ts
!src/environments/environment.prod.ts

# Environment variable files
.env
.env.*

# Optional npm cache
.npm

# Other
/.pnp
/.pnp.js

# Lockfiles (do NOT ignore package-lock.json by default; uncomment if you prefer to ignore)
# package-lock.json
