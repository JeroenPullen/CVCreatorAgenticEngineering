{
  "name": "cvcreator",
  "version": "1.0.0",
  "description": "A professional CV creation tool built with Angular",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "ng serve",
    "server": "node server/index.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
